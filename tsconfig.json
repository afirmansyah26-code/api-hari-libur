{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "src/domain/**/*",
    "src/providers/**/*",
    "src/services/**/*",
    "src/cache/**/*",
    "src/constants/**/*",
    "src/schema/**/*",
    "tests/**/*"
  ]
}
